# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# 필수 --------------------------------------------------------------------
GEMINI_API_KEY=

# 모델 --------------------------------------------------------------------
# 최신 모델일수록 붐벼서 503 이 잦습니다. python -m tools.check_models 로 먼저 재보세요.
CAPTION_MODEL=gemini-3.5-flash
ANSWER_MODEL=gemini-3.5-flash-lite
# 임베딩(글 좌표) 모델. 할당량은 모델별로 따로 잡힙니다.
# ⚠ 이 값을 바꾸면 벡터 공간이 달라져 기존 색인과 섞이지 않습니다.
#   바꿨다면 반드시: python -m tools.reembed --yes
GEMINI_EMBED_MODEL=gemini-embedding-2
MAX_GEMINI_CALLS_PER_VIDEO=1
# ⚠ 무료 티어는 모델당 하루 20회입니다. 영상 1개가 쓰는 호출 수 = ASR + 캡션.
#   ASR_BACKEND=gemini 면 영상당 4회(=하루 5개), 아래 조합이면 1회(=하루 20개)입니다.
GRID_FRAMES=12              # 그리드 1장에 넣을 프레임 수. 타일은 270x480 고정이라 화질은 그대로

# 장치 — ⚠ cuda/cpu 는 반드시 여기 한 줄로만 바꿉니다 (마스터 문서 8장)
DEVICE=cpu

# 파이프라인 백엔드: demo 기본값 → 담당자가 진짜 모델을 붙일 때 이 줄만 바꿉니다
# ASR_BACKEND: gemini | faster-whisper | whisperx   (C)
#   ⚠ whisperx 는 Python 3.13 이하에서만 설치됩니다(3.14 미지원).
#     3.14 라면 faster-whisper 를 쓰세요 — WhisperX 내부에서 도는 바로 그 엔진이고
#     word_timestamps 로 단어 단위 시각도 나옵니다.
#   ⚠ 셋 다 gemini 로 두면 할당량이 떨어질 때 음성·자막·장면이 동시에 비어
#     "장면 카드를 하나도 만들지 못했습니다" 로 저장이 통째로 실패합니다.
#     ASR 만 로컬로 빼도 캡션이 429 여도 저장은 성공합니다. (pip install faster-whisper)
ASR_BACKEND=faster-whisper
#   ⚠ 아래 로컬 조합을 쓰려면 먼저 설치해야 합니다. 안 깔고 바꾸면 서버가 뜨다가 죽습니다.
#     pip install faster-whisper easyocr FlagEmbedding
OCR_BACKEND=easyocr         # easyocr  | rapidocr | gemini   (C)
TEXT_EMBED_BACKEND=bge      # bge      | st       | gemini   (D)
IMAGE_EMBED_BACKEND=siglip  # siglip   | none     (D)

WHISPER_MODEL=small
BGE_MODEL=BAAI/bge-m3
# TEXT_EMBED_BACKEND=st 일 때의 모델(비교 후보, pip install sentence-transformers).
# ⚠ BGE-M3 와 KURE-v1 은 차원이 같아(1024) 창고에 섞여도 오류가 나지 않습니다. 기본 조건에서 바꾸면
#   python -m tools.reembed --yes 로 다시 색인하세요. 비교만 할 거면 조건 local_v2 를 쓰는 편이 안전합니다.
ST_MODEL=nlpai-lab/KURE-v1
SIGLIP_ADAPTER=             # 요리 도메인 LoRA. 측정 결과 이득이 없어 비워 둡니다
# 2026-09-17 비활성화. RecipeGen(4:3 중국 웹사진)으로 학습한 선형 정렬은
# 실제 9:16 쇼츠 프레임에서 성능을 깎습니다. custom_dataset 1,468쌍 측정:
#   영어 질의  base 0.6582 -> 정렬 0.5951  (CI [-0.084,-0.043])
#   한국어     base 0.5202 -> 정렬 0.4900  (CI [-0.057,-0.003])
SIGLIP_PROJECTION=
# SigLIP2 는 한국어가 약합니다(실제 쇼츠 측정: 한국어 0.520 vs 영어 0.658).
# true 면 그림 좌표용 질의만 영어로 번역합니다. 글 좌표는 한국어 그대로 갑니다.
# 번역 결과는 data/query_translations.json 에 저장되어 재현됩니다.
SIGLIP_QUERY_TRANSLATE=true

# 추출 파라미터 (확장프로그램이 /api/health 로 받아갑니다)
FRAME_INTERVAL=0.5
FRAME_WIDTH=540
FRAME_HEIGHT=960
FRAME_QUALITY=0.75

# 장면 카드 / 검색
SEGMENT_SECONDS=4.0
SEEK_LEAD_SECONDS=1.5
SEARCH_TOP_K=5

# Qdrant: 비워두면 data/qdrant 폴더에 로컬 저장 (도커 불필요)
# 4명이 창고를 공유하려면 Qdrant Cloud 주소를 넣으세요.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=shorts_segments
